# ==============================================================================
# Inpainter — CPU-Only Backend Image
# Target: Mac Docker (CPU only — Apple MPS requires native macOS, not Docker)
#         or any machine without an NVIDIA GPU
# ==============================================================================
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# ==============================================================================
# Dependencies layer
# ==============================================================================
FROM base AS deps
WORKDIR /app

COPY pyproject.toml .
COPY .python-version .

# Install CPU PyTorch
RUN uv pip install --system torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining dependencies
RUN uv pip install --system \
    "diffusers>=0.30.0" \
    "transformers>=4.44.0" \
    "accelerate>=0.33.0" \
    "Pillow>=10.0.0" \
    "numpy>=1.26.0" \
    "pyyaml>=6.0" \
    "typer>=0.12.0" \
    "fastapi>=0.112.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.0.0" \
    "pydantic-settings>=2.0.0" \
    "python-multipart>=0.0.9" \
    "aiofiles>=23.0.0" \
    "rich>=13.0.0" \
    "psutil>=5.9.0" \
    "httpx>=0.27.0"

# ==============================================================================
# Application runtime
# ==============================================================================
FROM deps AS app
WORKDIR /app

COPY orchestrator/ ./orchestrator/
COPY cli/ ./cli/
COPY tools/ ./tools/
COPY ui/app.py ./ui/app.py
COPY ui/__init__.py ./ui/__init__.py
COPY config/ ./config/

RUN mkdir -p /app/output /app/loras /app/inputs

ENV PYTHONPATH=/app
ENV INPAINTER_DEVICE=cpu
ENV HF_HOME=/app/.cache/huggingface

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health').raise_for_status()" || exit 1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "ui.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
