# ==============================================================================
# Inpainter Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# HuggingFace token (Required for gated FLUX.1-dev weights)
# Create a token at: https://huggingface.co/settings/tokens
# Accept license at: https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=hf_your_token_here

# HuggingFace model cache directory (FLUX.1-dev weights require ~24 GB)
# Point this to a disk partition with at least 50 GB free
HF_HOME=~/.cache/huggingface

# Device override: auto | cuda | mps | cpu (leave as auto to auto-detect)
INPAINTER_DEVICE=auto

# Service ports
API_PORT=8000
FRONTEND_PORT=3000
